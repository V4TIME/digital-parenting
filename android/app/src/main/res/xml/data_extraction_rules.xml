<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent token and the child's settings live in SharedPreferences. Backing
  them up to the cloud (or extracting them over ADB) would hand out full API
  access to the collector, so nothing is backed up at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
